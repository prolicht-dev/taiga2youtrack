  getProjects() {
    return [this.ytProject];
  }

  /**
   * Returns users belonging to the specified group.
   * @param {UserGroup} group The user group to retrieve members of.
   * @param {number} skip Number of heading records to skip.
   * @param {number} top Maximum number of records to be returned. If more records are returned, only `top` number
   * of these records will be processed and the rest will be ignored.
   * @returns {User[]} A list of users that belong to the specified project.
   */

  getUsers(group, skip, top) {
    if (group.id === projectUserGroup.id) {
      return this.ytUsers.slice(skip, skip + top);
    }
    return [];
  }

  /**
   * getIssues() is invoked after you created a fresh import. It runs in patches of 50 for as long as one array is smaller or empty than 50 items.
   * On first run allo issues are created, but without issue links. This is because ids can be referenced from higher to lower and lower to higher.
   * And import order can not gurantee that the referenced issue exists already.
   * 
   * @param {ProjectInfo} projectInfo The project the returned issues belong to.
   * @param {DocumentInfo=} after The issue that the returned issues follow.
   * @param {number} top The number of issues to be returned. If there are fewer issues left to import, the method returns them all,
   * if the method returns more issues than it was requested, those extra issues are not processed, and the next time the method is called,
   * the last of the processed issues is passed into `after` parameter.
   * @returns {Issue[]} A list of issues that follow the specified one in the specified project.
   */
  getIssues(projectInfo, after, top) {
    let updatedAfter = new Date().toLocaleDateString();
    let result = this.createOrUpdateIssues(projectInfo, after, updatedAfter, top, false, this.ytIssueCounter);    
    let issues = result.ytIssues;
    // if less issues are returned, than the skip size, it means the last batch was request
    // after the last batch the issue counter must be reset, to be fresh for next iteration
    // this will not produce an endless loop as youtrack stops here as well
    this.ytIssueCounter = issues.length < top ? 0 : result.counter;
    return issues;
  }

  /**
   * Usually this method is invoked if continous integration = true, but it is also called on every additional import request
   * after the inital one. We do not use continus integration. However we use it to create the links that were not created on first run.
   * 
   * @param {ProjectInfo} projectInfo The project where the requested issues belong.
   * @param {DocumentInfo} [after] The issue that the requested issues follow.
   * @param {string} updatedAfter The requested issues are expected to be updated after this timestamp.
   * @param {number} top The number of issues to be returned. If there are fewer issues left to import, the method returns them all.
   * If the method returns more issues than it was requested, those extra issues are not processed, and the next time the method is called,
   * the last of the processed issues is passed into `after` parameter.
   * @returns {Issue[]} Issues following the specified one in the specified project that were updated after the specified timestamp.
   */
  getIssueUpdates(projectInfo, after, updatedAfter, top) {
    let result = this.createOrUpdateIssues(projectInfo, after, updatedAfter, top, true, this.ytUpdateCounter);
    this.ytUpdateCounter = result.counter;
    let issues = result.ytIssues;
     // if less issues are returned, than the skip size, it means the last batch was request
    // after the last batch the issue counter must be reset, to be fresh for next iteration
    // this will not produce an endless loop as youtrack stops here as well
    this.ytUpdateCounter = issues.length < top ? 0 : result.counter;
    return issues;
  }

  /**
   * This method fetches /issues from the configurated url and imports them, either with links or without.
   * 
   * @param projectInfo ignored, would contain all project info 
   * @param after object of id and key. represents the last object from last run and the first of this run
   * @param updatedAfter ignored, is a datetime as string, would fetch all issues after this date
   * @param top skip (batch) size
   * @param isUpdate boolean if true also adds links, on false links can not be created
   * @param counter reference to a this counter variable. youtrack uses the id to paginate and just simply expects, that they come ordered
   * we do not send them ordered, so we have to count ourselves
   * @returns 
   */
  createOrUpdateIssues(projectInfo, after, updatedAfter, top, isUpdate, counter) {
    if (!counter) {
      counter = 0;
    }
    console.debug(`Creating issues: skip: ${this.ytIssueCounter}, take: ${top}`);
    if (after === null) {
      after = {
        'id': "null",
        'key': "null"
      }
    }

    var response = this.connection.getSync('/issues', {
      'page_size': top.toString(),
      'skip': counter.toString()
    });
    var responseObj = JSON.parse(response.response);
    var issues = responseObj.data.issues;
    var tasks = responseObj.data.tasks;
    var userStories = responseObj.data.user_stories;
    var epics = responseObj.data.epics;

    let ytIssues = [];
    if (issues != undefined && issues.length > 0) {
      ytIssues = ytIssues.concat(this.convertAllTaigaIssues(issues, isUpdate));
    }

    if (tasks != undefined && tasks.length > 0) {
      ytIssues = ytIssues.concat(this.convertAllTaigaTasks(tasks, isUpdate));
    }

    if (userStories != undefined && userStories.length > 0) {
      ytIssues = ytIssues.concat(this.convertAllTaigaUserStories(userStories, isUpdate));
    }

    if (epics != undefined && epics.length > 0) {
      ytIssues = ytIssues.concat(this.convertAllTaigaEpics(epics, isUpdate));
    }

    // this should gurantee that skip always works, but we do the skip ourselves
    // I just leave this here to make youtrack happy.
    ytIssues.sort((a, b) => a.id - b.id);
    counter += ytIssues.length;
    return {
      ytIssues, counter
    };
  }

  /**
   * ID of the timezone of the user who runs the import.
   * If `null` or empty, the import script will use the timezone of the YouTrack user.
   * @returns {string} The ID of the user timezone.
   */
  getUserTimeZoneId() {
    return 'Europe/Vienna';
  }

