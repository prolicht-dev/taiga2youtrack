  // for every id by type create an empty issue
  createEmptyAll(issueType, data) {
    console.debug(`creating ${issueType}: ${JSON.stringify(data)}`);
    let empties = [];
    data.forEach(id => {
      if (id == undefined) {
        console.log(`id for issueType ${issueType} in data ${JSON.stringify(data)} is undefined`);
        return;
      }
      // console.log(`id: ${id}`);
      empties.push(this.createEmptySingle(issueType, id));
    });
    console.debug(`created ${empties.length} ${issueType}: ${JSON.stringify(empties)}`);
    return empties;
  }

  // issus are created empty, so all ids for setting up links already exist
  createEmptySingle(issueType, id) {
    return {
      id: id.toString(),
      key: this.makeKey(id),
      fields: {
        Type: {
          type: 'enum',
          value: this.issueTypes.get(issueType)
        },
      }
    }
  }

  makeKey(id) {
    return `${this.ytProject.key}-${id}`;
  }
